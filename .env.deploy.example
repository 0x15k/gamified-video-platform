# Copy to .env.deploy and fill with your Neon + Upstash URLs (never commit .env.deploy).
# Then run: npm run env:vercel

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
NEXT_PUBLIC_SITE_URL=https://gamified-video-platform.vercel.app
