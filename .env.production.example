# Copy these names into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values. Generate secrets with: openssl rand -base64 32

DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEDIA_SIGNING_SECRET=
MEDIA_TOKEN_TTL_SEC=120
NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
PLATFORM_VERTICAL=ADULT
PLATFORM_AGE_GATE=true
ADS_ENABLED=false

